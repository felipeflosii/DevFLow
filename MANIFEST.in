include README.md LICENSE SECURITY.md CONTRIBUTING.md COLLABORATING.md CODE_OF_CONDUCT.md SUPPORT.md
include CHANGELOG.md RELEASE_NOTES.md install.sh install.ps1
recursive-include docs *.md
recursive-include .github *.md *.yml
recursive-include tests *.py
prune .venv
prune .pytest_cache
prune dist
prune build
global-exclude __pycache__ *.py[cod] .DS_Store
